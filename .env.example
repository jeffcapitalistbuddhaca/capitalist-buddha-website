# ⚠️ NEVER commit actual secrets. This file shows the structure only.
# Copy this to .env and fill in your actual values for local development.

# Stripe API Keys (get from stripe.com/dashboard)
STRIPE_SECRET_KEY=rk_test_51...your_stripe_test_key...
STRIPE_PUBLISHABLE_KEY=pk_test_51...your_stripe_publishable_key...

# Brevo (Sendinblue) API Key (get from app.brevo.com/settings)
BREVO_API_KEY=xkeysib-...your_brevo_api_key...

# Cloudflare R2 Credentials (get from Cloudflare dashboard)
R2_ACCESS_KEY_ID=your_r2_access_key_id...
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key...

# Firebase Service Account (get from Firebase console)
FIREBASE_CREDENTIALS={"type":"service_account","project_id":"..."}

# Environment
ENVIRONMENT=development
